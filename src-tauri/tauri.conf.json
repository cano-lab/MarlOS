{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarlOS",
  "version": "0.1.0",
  "identifier": "com.marlos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MarlOS [feature]",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://localhost:* https://api.anthropic.com https://api.openai.com; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [],
    "copyright": "Copyright © 2026 MarlOS",
    "shortDescription": "Semantic Document Environment",
    "longDescription": "MarlOS is a local-first, AI-enhanced document environment that remembers your work context. Features semantic search, session tracking, and intelligent code assistance.",
    "windows": {
      "wix": {
        "language": "en-US",
        "template": null,
        "upgradeCode": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
      }
    },
    "iOS": {
      "developmentTeam": ""
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
